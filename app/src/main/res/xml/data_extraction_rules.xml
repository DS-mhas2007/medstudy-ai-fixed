<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 12+ cloud backup and device-to-device transfer. Courses, notes, flashcards and imported PDFs are
    kept; DataStore (settings and the encrypted API key) is never copied.
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="medstudy_database" />
        <include domain="file" path="pdfs/" />
        <exclude domain="file" path="datastore/" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="medstudy_database" />
        <include domain="file" path="pdfs/" />
        <exclude domain="file" path="datastore/" />
    </device-transfer>
</data-extraction-rules>
